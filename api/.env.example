# Porta em que a API escuta (padrão: 8080)
PORT=3000

# Conexão com o Postgres.
# Rodando a API na sua máquina (go tool air / make dev), use host=localhost.
# Dentro do docker compose, o host é o nome do serviço: host=db.
DATABASE_URL=host=localhost user=postgres password=postgres dbname=projects port=5432 sslmode=disable

# Pasta onde as capas dos projetos são salvas (padrão: uploads)
UPLOADS_BASE_PATH=uploads

# Origens liberadas no CORS, separadas por vírgula (a URL do front)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
